{
  "expo": {
    "name": "LifeCity Attendance",
    "slug": "lifecity-attendance",
    "scheme": "lifecity",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.lifecity.attendance",
      "versionCode": 1,
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#eff8f5" },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow LifeCity to scan member QR codes.", "recordAudioAndroid": false }],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": { "autolinkingModuleResolution": true }
  }
}
