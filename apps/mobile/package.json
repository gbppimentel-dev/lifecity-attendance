{
  "name": "lifecity-android",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "check": "expo install --check",
    "export:android": "expo export --platform android",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "expo": "58.0.21",
